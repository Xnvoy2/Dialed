{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "DIALED_API_URL": "https://dialed-api-ten.vercel.app",
        "DIALED_BLOCKING": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "DIALED_API_URL": "https://dialed-api-ten.vercel.app",
        "DIALED_BLOCKING": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
