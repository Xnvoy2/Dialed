{
  "name": "dialed-server",
  "private": true,
  "version": "0.1.0",
  "description": "Dialed backend: Sign in with Apple, rewards ledger and payouts. Simulated, Solana devnet, or guarded mainnet.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "dev": "tsx watch src/http/main.ts",
    "start": "tsx src/http/main.ts",
    "dialed": "tsx src/cli/dialed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "DIALED_ENV=test tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@solana-program/memo": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.5.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peculiar/x509": "^2.2.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2"
  }
}
