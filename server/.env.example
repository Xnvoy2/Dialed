# Copy to .env (git-ignored). Never commit real secrets or keys.
DIALED_ENV=development
DIALED_PAYOUT_NETWORK=simulated        # simulated | devnet  (mainnet is refused)
DIALED_DEV_AUTH=1                      # simulator sign-in; ignored in staging
DIALED_REVIEW_HOURS=0                  # hours an award stays pending (24 recommended)
# DIALED_SESSION_SECRET=               # required in staging, 32+ chars
# DATABASE_URL=postgres://localhost/dialed_dev
# APPLE_BUNDLE_ID=com.joshbarton.dialed
# Devnet only:
# SOLANA_RPC_URL=https://api.devnet.solana.com
# DIALED_SIGNER_KEYPAIR=/Users/you/.config/dialed/treasury-devnet.json
