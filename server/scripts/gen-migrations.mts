/** Embeds migrations/*.sql into src/db/migrationFiles.ts so serverless bundles include them. */
import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
const root = resolve(import.meta.dirname, '..');
const files = readdirSync(resolve(root, 'migrations')).filter((f) => f.endsWith('.sql')).sort();
const body = files.map((f) => `  { name: ${JSON.stringify(f)}, sql: ${JSON.stringify(readFileSync(resolve(root, 'migrations', f), 'utf8'))} },`).join('\n');
writeFileSync(
  resolve(root, 'src/db/migrationFiles.ts'),
  `// Generated by \`npm run gen:migrations\` from migrations/*.sql. Do not edit by hand.\nexport const MIGRATIONS: { name: string; sql: string }[] = [\n${body}\n];\n`,
);
console.log(`embedded ${files.length} migrations`);
